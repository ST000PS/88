<!-- Seek: the needle scans down from 108 and locks onto 88.8 (overshooting a touch), then drifts like an analogue tuner. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="320dp" android:height="34dp" android:viewportWidth="320" android:viewportHeight="34">
            <group android:name="seek" android:translateX="261.1">
                <group android:name="drift">
                <path android:strokeColor="#55C04A5E" android:strokeWidth="5" android:strokeLineCap="round" android:pathData="M43.68,3V31" />
                <path android:strokeColor="#C04A5E" android:strokeWidth="1.6" android:strokeLineCap="round" android:pathData="M43.68,1.5V32.5" />
                </group>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="seek">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="translateX" android:valueFrom="261.1" android:valueTo="0"
                android:duration="1500" android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="drift">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="3400" android:repeatCount="infinite" android:startOffset="1500" android:interpolator="@android:anim/linear_interpolator">
                <propertyValuesHolder android:propertyName="translateX" android:valueType="floatType">
                    <keyframe android:fraction="0.000" android:value="0" />
                    <keyframe android:fraction="0.180" android:value="-1.4" />
                    <keyframe android:fraction="0.310" android:value="-0.6" />
                    <keyframe android:fraction="0.520" android:value="0.9" />
                    <keyframe android:fraction="0.700" android:value="0.3" />
                    <keyframe android:fraction="0.860" android:value="1.2" />
                    <keyframe android:fraction="1.000" android:value="0" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
</animated-vector>
