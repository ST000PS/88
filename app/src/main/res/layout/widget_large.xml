<?xml version="1.0" encoding="utf-8"?>
<!-- Card: header, cover / title / time, the sample strip, and a row of keys. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/w_body">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
        android:paddingStart="12dp" android:paddingTop="11dp" android:paddingEnd="12dp" android:paddingBottom="11dp">
        <include layout="@layout/widget_header" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <include layout="@layout/widget_title" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <include layout="@layout/widget_sample_small" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="8dp" android:orientation="horizontal">
            <ImageButton android:id="@+id/w_shuffle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="5dp" android:background="@drawable/w_key" android:src="@drawable/w_i_shuffle" android:contentDescription="Shuffle everything" />
            <ImageButton android:id="@+id/w_prev" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="5dp" android:background="@drawable/w_key" android:src="@drawable/w_i_prev" android:contentDescription="Previous" />
            <include layout="@layout/widget_play" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1.6" android:layout_marginEnd="5dp" />
            <ImageButton android:id="@+id/w_next" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"  android:background="@drawable/w_key" android:src="@drawable/w_i_next" android:contentDescription="Next" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/w_grain" />
</FrameLayout>
