<?xml version="1.0" encoding="utf-8"?>
<!-- Card: header, cover / title / time, progress, the FM dial window, and a row of keys. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/w_body">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="14dp" android:paddingTop="12dp" android:paddingEnd="14dp"
        android:paddingBottom="12dp">
        <include layout="@layout/widget_header" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <include layout="@layout/widget_title" />
        <include layout="@layout/widget_line" android:layout_width="match_parent" android:layout_height="2dp"
            android:layout_marginTop="8dp" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <include layout="@layout/widget_tuner_fm" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <ImageButton android:id="@+id/w_shuffle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/w_key" android:src="@drawable/w_i_shuffle" android:contentDescription="Shuffle everything" />
            <ImageButton android:id="@+id/w_prev" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/w_key" android:src="@drawable/w_i_prev" android:contentDescription="Previous" />
            <include layout="@layout/widget_play" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1.6" android:layout_marginEnd="6dp" />
            <ImageButton android:id="@+id/w_next" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"  android:background="@drawable/w_key" android:src="@drawable/w_i_next" android:contentDescription="Next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
