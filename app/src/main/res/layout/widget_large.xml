<?xml version="1.0" encoding="utf-8"?>
<!-- Card: ON AIR header, art beside title / info / timer, then the FM dial beside the transport. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_fill" android:contentDescription="@null" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_shade" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/w_art" android:layout_width="60dp" android:layout_height="60dp"
                android:background="@drawable/widget_art_bg" android:clipToOutline="true"
                android:scaleType="centerCrop" android:src="@mipmap/ic_launcher" android:contentDescription="@null" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="12dp" android:orientation="vertical">
                <include layout="@layout/widget_onair" />
                <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:ellipsize="end" android:fontFamily="monospace" android:maxLines="1"
                    android:text="@string/app_name" android:textColor="#EDEDED" android:textSize="15sp" android:textStyle="bold" />
                <include layout="@layout/widget_info" />
                <include layout="@layout/widget_time" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp"
            android:gravity="center_vertical" android:orientation="horizontal">
            <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginEnd="8dp">
                <include layout="@layout/widget_dial" />
            </FrameLayout>
            <ImageButton android:id="@+id/w_shuffle" android:layout_width="34dp" android:layout_height="34dp"
                android:background="@null" android:src="@drawable/ic_w_shuffle" android:contentDescription="Shuffle everything" />
            <ImageButton android:id="@+id/w_prev" android:layout_width="38dp" android:layout_height="38dp"
                android:background="@null" android:src="@drawable/ic_w_prev" android:contentDescription="Previous" />
            <ImageButton android:id="@+id/w_play" android:layout_width="44dp" android:layout_height="44dp"
                android:background="@drawable/widget_play_bg" android:src="@drawable/ic_w_play" android:contentDescription="Play or pause" />
            <ImageButton android:id="@+id/w_next" android:layout_width="38dp" android:layout_height="38dp"
                android:background="@null" android:src="@drawable/ic_w_next" android:contentDescription="Next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
