<?xml version="1.0" encoding="utf-8"?>
<!-- The FM tuner strip. Scale and needle layers share one 240-wide drawing stretched to the widget,
     so 88.8 is always the middle. Two copies of the tuning animation take turns, one per track, so
     each new track replays the sweep. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="24dp">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/w_dial" android:contentDescription="@null" />
    <ProgressBar android:id="@+id/w_needle_a" android:layout_width="match_parent" android:layout_height="match_parent"
        android:minHeight="24dp" android:maxHeight="24dp" android:maxWidth="2000dp" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateTint="#FFFFFFFF" android:indeterminateTintMode="multiply"
        android:indeterminateDrawable="@drawable/w_needle_tune" android:visibility="gone" />
    <ProgressBar android:id="@+id/w_needle_b" android:layout_width="match_parent" android:layout_height="match_parent"
        android:minHeight="24dp" android:maxHeight="24dp" android:maxWidth="2000dp" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateTint="#FFFFFFFF" android:indeterminateTintMode="multiply"
        android:indeterminateDrawable="@drawable/w_needle_tune" android:visibility="gone" />
    <ImageView android:id="@+id/w_needle_on" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/w_needle_on" android:contentDescription="@null" android:visibility="gone" />
    <ImageView android:id="@+id/w_needle_parked" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/w_needle_parked" android:contentDescription="@null" />
</FrameLayout>
