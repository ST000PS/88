<?xml version="1.0" encoding="utf-8"?>
<!-- The sample strip, compact (no label row). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <FrameLayout android:layout_width="match_parent" android:layout_height="24dp" android:background="@drawable/w_panel" android:padding="1dp">
        <ImageView android:id="@+id/w_wave" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="fitXY" android:contentDescription="@null" />
        <ProgressBar android:id="@+id/w_wave_pos" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent"
            android:layout_height="match_parent" android:minHeight="24dp" android:maxHeight="24dp" android:max="1000" android:progress="0"
            android:progressDrawable="@drawable/w_wave_pos" />
    </FrameLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="7dp" android:layout_marginTop="5dp">
        <ImageView android:id="@+id/w_seq_marks" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="fitXY" android:src="@drawable/w_seq_off" android:contentDescription="@null" />
        <ProgressBar android:id="@+id/w_seq_70" android:layout_width="match_parent" android:layout_height="match_parent"
            android:minHeight="7dp" android:maxHeight="7dp" android:maxWidth="2000dp" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateTint="#FFFFFFFF" android:indeterminateTintMode="multiply"
            android:indeterminateDrawable="@drawable/w_seq_head_t70" android:visibility="gone" />
        <ProgressBar android:id="@+id/w_seq_80" android:layout_width="match_parent" android:layout_height="match_parent"
            android:minHeight="7dp" android:maxHeight="7dp" android:maxWidth="2000dp" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateTint="#FFFFFFFF" android:indeterminateTintMode="multiply"
            android:indeterminateDrawable="@drawable/w_seq_head_t80" android:visibility="gone" />
        <ProgressBar android:id="@+id/w_seq_90" android:layout_width="match_parent" android:layout_height="match_parent"
            android:minHeight="7dp" android:maxHeight="7dp" android:maxWidth="2000dp" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateTint="#FFFFFFFF" android:indeterminateTintMode="multiply"
            android:indeterminateDrawable="@drawable/w_seq_head_t90" android:visibility="gone" />
        <ProgressBar android:id="@+id/w_seq_100" android:layout_width="match_parent" android:layout_height="match_parent"
            android:minHeight="7dp" android:maxHeight="7dp" android:maxWidth="2000dp" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateTint="#FFFFFFFF" android:indeterminateTintMode="multiply"
            android:indeterminateDrawable="@drawable/w_seq_head_t100" android:visibility="gone" />
        <ProgressBar android:id="@+id/w_seq_115" android:layout_width="match_parent" android:layout_height="match_parent"
            android:minHeight="7dp" android:maxHeight="7dp" android:maxWidth="2000dp" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateTint="#FFFFFFFF" android:indeterminateTintMode="multiply"
            android:indeterminateDrawable="@drawable/w_seq_head_t115" android:visibility="gone" />
        <ProgressBar android:id="@+id/w_seq_135" android:layout_width="match_parent" android:layout_height="match_parent"
            android:minHeight="7dp" android:maxHeight="7dp" android:maxWidth="2000dp" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateTint="#FFFFFFFF" android:indeterminateTintMode="multiply"
            android:indeterminateDrawable="@drawable/w_seq_head_t135" android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
