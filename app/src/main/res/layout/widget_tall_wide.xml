<?xml version="1.0" encoding="utf-8"?>
<!-- Big card on a wide widget (bigger pads / record / cover). A hi-fi front panel: header; the hero (sampler pads drumming at the track's tempo beside an LCD, or a record ringed by progress,
     or the cover); cover / title / time; progress; the FM / AM dial window; a row of keys. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/w_body">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="14dp" android:paddingEnd="16dp"
        android:paddingBottom="14dp">
        <include layout="@layout/widget_header" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:layout_marginTop="10dp" android:layout_marginBottom="10dp">
            <include layout="@layout/widget_pads_wide" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" />
            <FrameLayout android:id="@+id/w_record" android:layout_width="176dp" android:layout_height="176dp"
                android:layout_gravity="center" android:visibility="gone">
                <ProgressBar android:id="@+id/w_ring" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:minWidth="176dp" android:maxWidth="176dp" android:minHeight="176dp" android:maxHeight="176dp"
                    android:max="1000" android:progress="0" android:progressDrawable="@drawable/w_ring" />
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="8dp"
                    android:src="@drawable/w_vinyl" android:contentDescription="@null" />
                <ImageView android:id="@+id/w_label" android:layout_width="76dp" android:layout_height="76dp"
                    android:layout_gravity="center" android:scaleType="centerCrop" android:src="@drawable/w_label_blank"
                    android:contentDescription="@null" />
                <ProgressBar android:id="@+id/w_sheen_on" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:layout_margin="8dp" android:minWidth="160dp" android:maxWidth="160dp" android:minHeight="160dp"
                    android:maxHeight="160dp" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateTint="#FFFFFFFF" android:indeterminateTintMode="multiply"
                    android:indeterminateDrawable="@drawable/w_sheen_anim" android:visibility="gone" />
                <ImageView android:id="@+id/w_sheen_off" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:layout_margin="8dp" android:src="@drawable/w_sheen" android:contentDescription="@null" />
            </FrameLayout>
            <ImageView android:id="@+id/w_cover" android:layout_width="176dp" android:layout_height="176dp"
                android:layout_gravity="center" android:background="@drawable/w_thumb" android:clipToOutline="true"
                android:scaleType="centerCrop" android:src="@mipmap/ic_launcher" android:contentDescription="@null"
                android:visibility="gone" />
        </FrameLayout>
        <include layout="@layout/widget_title" />
        <include layout="@layout/widget_line" android:layout_width="match_parent" android:layout_height="2dp"
            android:layout_marginTop="10dp" />
        <include layout="@layout/widget_tuner" android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="12dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="10dp"
            android:orientation="horizontal">
            <include layout="@layout/widget_fav" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_marginEnd="6dp" />
            <ImageButton android:id="@+id/w_prev" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/w_key" android:src="@drawable/w_i_prev" android:contentDescription="Previous" />
            <include layout="@layout/widget_play" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1.6" android:layout_marginEnd="6dp" />
            <ImageButton android:id="@+id/w_next" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/w_key" android:src="@drawable/w_i_next" android:contentDescription="Next" />
            <ImageButton android:id="@+id/w_shuffle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"  android:background="@drawable/w_key" android:src="@drawable/w_i_shuffle" android:contentDescription="Shuffle everything" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
