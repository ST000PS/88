<?xml version="1.0" encoding="utf-8"?>
<!-- Big card: a record with the cover as its label (or the plain cover), ringed by the track's progress;
     ON AIR header, title / info / timer, the FM dial, and the full transport. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent">
    <include layout="@layout/widget_bg" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="16dp">
        <include layout="@layout/widget_onair" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:layout_marginTop="6dp" android:baselineAligned="false" android:gravity="center_vertical"
            android:orientation="horizontal">
            <FrameLayout android:id="@+id/w_record" android:layout_width="140dp" android:layout_height="140dp">
                <ProgressBar android:id="@+id/w_ring" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:minWidth="140dp" android:maxWidth="140dp" android:minHeight="140dp" android:maxHeight="140dp"
                    android:max="1000" android:progress="0" android:progressDrawable="@drawable/w_ring" />
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="8dp"
                    android:src="@drawable/w_vinyl" android:contentDescription="@null" />
                <ImageView android:id="@+id/w_label" android:layout_width="60dp" android:layout_height="60dp"
                    android:layout_gravity="center" android:scaleType="centerCrop" android:src="@drawable/w_label_blank"
                    android:contentDescription="@null" />
                <ProgressBar android:id="@+id/w_sheen_on" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:layout_margin="8dp" android:minWidth="124dp" android:maxWidth="124dp" android:minHeight="124dp"
                    android:maxHeight="124dp" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateTint="#FFFFFFFF" android:indeterminateTintMode="multiply"
                    android:indeterminateDrawable="@drawable/w_sheen_anim" android:visibility="gone" />
                <ImageView android:id="@+id/w_sheen_off" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:layout_margin="8dp" android:src="@drawable/w_sheen" android:contentDescription="@null" />
            </FrameLayout>
            <ImageView android:id="@+id/w_cover" android:layout_width="132dp" android:layout_height="132dp"
                android:background="@drawable/widget_art_bg" android:clipToOutline="true" android:scaleType="centerCrop"
                android:src="@mipmap/ic_launcher" android:contentDescription="@null" android:visibility="gone" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="14dp" android:orientation="vertical">
                <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:ellipsize="end" android:fontFamily="monospace" android:maxLines="2" android:text="@string/app_name"
                    android:textColor="#EDEDED" android:textSize="19sp" android:textStyle="bold" />
                <include layout="@layout/widget_info" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />
                <include layout="@layout/widget_time" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
                <TextView android:id="@+id/w_next_line" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:ellipsize="end" android:fontFamily="monospace" android:maxLines="1"
                    android:textColor="#8A8A8A" android:textSize="10sp" android:visibility="gone" />
                <include layout="@layout/widget_line" android:layout_width="match_parent" android:layout_height="2dp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:fontFamily="monospace" android:text="FM" android:textColor="#7A7A7A" android:textSize="9sp" />
            <TextView android:id="@+id/w_freq" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="monospace" android:text="88.8 MHz" android:textColor="#7A7A7A" android:textSize="9sp" />
        </LinearLayout>
        <include layout="@layout/widget_dial" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp"
            android:gravity="center" android:orientation="horizontal">
            <include layout="@layout/widget_fav" android:layout_width="44dp" android:layout_height="44dp"
                android:layout_marginEnd="6dp" />
            <ImageButton android:id="@+id/w_prev" android:layout_width="48dp" android:layout_height="48dp"
                android:layout_marginEnd="8dp" android:background="@null" android:src="@drawable/ic_w_prev" android:contentDescription="Previous" />
            <include layout="@layout/widget_play" android:layout_width="56dp" android:layout_height="56dp" />
            <ImageButton android:id="@+id/w_next" android:layout_width="48dp" android:layout_height="48dp"
                android:layout_marginStart="8dp" android:background="@null" android:src="@drawable/ic_w_next" android:contentDescription="Next" />
            <ImageButton android:id="@+id/w_shuffle" android:layout_width="44dp" android:layout_height="44dp"
                android:layout_marginStart="6dp" android:background="@null" android:src="@drawable/ic_w_shuffle"
                android:contentDescription="Shuffle everything" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
