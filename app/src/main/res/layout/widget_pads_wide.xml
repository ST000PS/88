<?xml version="1.0" encoding="utf-8"?>
<!-- The hero: a sampler. A 4×4 pad grid that finger-drums a boom-bap pattern at about the track's tempo
     (one animation per tempo band), beside an MPC-style LCD with the cover, sequence (track) number,
     BPM, release and running time. Paused: pads dark, LCD says so. Closed: LCD backlight off. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_sampler"
    android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
    <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:background="@drawable/w_pad_well" android:padding="7dp">
        <ProgressBar android:id="@+id/w_pads_70" android:layout_width="164dp" android:layout_height="164dp"
            android:minWidth="164dp" android:maxWidth="164dp" android:minHeight="164dp" android:maxHeight="164dp" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateTint="#FFFFFFFF" android:indeterminateTintMode="multiply"
            android:indeterminateDrawable="@drawable/w_pads_t70" android:visibility="gone" />
        <ProgressBar android:id="@+id/w_pads_80" android:layout_width="164dp" android:layout_height="164dp"
            android:minWidth="164dp" android:maxWidth="164dp" android:minHeight="164dp" android:maxHeight="164dp" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateTint="#FFFFFFFF" android:indeterminateTintMode="multiply"
            android:indeterminateDrawable="@drawable/w_pads_t80" android:visibility="gone" />
        <ProgressBar android:id="@+id/w_pads_90" android:layout_width="164dp" android:layout_height="164dp"
            android:minWidth="164dp" android:maxWidth="164dp" android:minHeight="164dp" android:maxHeight="164dp" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateTint="#FFFFFFFF" android:indeterminateTintMode="multiply"
            android:indeterminateDrawable="@drawable/w_pads_t90" android:visibility="gone" />
        <ProgressBar android:id="@+id/w_pads_100" android:layout_width="164dp" android:layout_height="164dp"
            android:minWidth="164dp" android:maxWidth="164dp" android:minHeight="164dp" android:maxHeight="164dp" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateTint="#FFFFFFFF" android:indeterminateTintMode="multiply"
            android:indeterminateDrawable="@drawable/w_pads_t100" android:visibility="gone" />
        <ProgressBar android:id="@+id/w_pads_115" android:layout_width="164dp" android:layout_height="164dp"
            android:minWidth="164dp" android:maxWidth="164dp" android:minHeight="164dp" android:maxHeight="164dp" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateTint="#FFFFFFFF" android:indeterminateTintMode="multiply"
            android:indeterminateDrawable="@drawable/w_pads_t115" android:visibility="gone" />
        <ProgressBar android:id="@+id/w_pads_135" android:layout_width="164dp" android:layout_height="164dp"
            android:minWidth="164dp" android:maxWidth="164dp" android:minHeight="164dp" android:maxHeight="164dp" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateTint="#FFFFFFFF" android:indeterminateTintMode="multiply"
            android:indeterminateDrawable="@drawable/w_pads_t135" android:visibility="gone" />
        <ImageView android:id="@+id/w_pads_rest" android:layout_width="164dp" android:layout_height="164dp"
            android:src="@drawable/w_pads_rest" android:contentDescription="@null" android:visibility="gone" />
        <ImageView android:id="@+id/w_pads_off" android:layout_width="164dp" android:layout_height="164dp"
            android:src="@drawable/w_pads_off" android:contentDescription="@null" />
    </FrameLayout>
    <LinearLayout android:id="@+id/w_lcd" android:layout_width="160dp" android:layout_height="match_parent"
        android:layout_marginStart="10dp" android:background="@drawable/w_lcd_off" android:orientation="vertical"
        android:paddingStart="11dp" android:paddingTop="10dp" android:paddingEnd="10dp" android:paddingBottom="9dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <ImageView android:id="@+id/w_lcd_art" android:layout_width="52dp" android:layout_height="52dp"
                android:scaleType="centerCrop" android:src="@mipmap/ic_launcher" android:contentDescription="@null" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="8dp" android:orientation="vertical">
                <TextView android:id="@+id/w_lcd_seq" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="monospace" android:text="SEQ --" android:textColor="#FF1C2617" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:id="@+id/w_lcd_bpm" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="monospace" android:text="BPM ---" android:textColor="#FF1C2617" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="7dp"
            android:background="#401C2617" />
        <TextView android:id="@+id/w_lcd_rel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:ellipsize="end" android:fontFamily="monospace" android:maxLines="1"
            android:textColor="#FF1C2617" android:textSize="11sp" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:id="@+id/w_lcd_state" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:fontFamily="monospace" android:textColor="#FF1C2617" android:textSize="11sp"
                android:textStyle="bold" />
            <Chronometer android:id="@+id/w_lcd_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="monospace" android:textColor="#FF1C2617" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
