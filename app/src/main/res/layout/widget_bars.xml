<?xml version="1.0" encoding="utf-8"?>
<!-- Level meter: one animation per tempo band, so the bars bounce at about the track's BPM. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="20dp" android:layout_height="14dp">
    <ProgressBar android:id="@+id/w_bars_70" android:layout_width="20dp" android:layout_height="14dp"
        android:minWidth="20dp" android:maxWidth="20dp" android:minHeight="14dp" android:maxHeight="14dp" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateTint="#FFFFFFFF" android:indeterminateTintMode="multiply"
        android:indeterminateDrawable="@drawable/w_bars_t70" android:visibility="gone" />
    <ProgressBar android:id="@+id/w_bars_80" android:layout_width="20dp" android:layout_height="14dp"
        android:minWidth="20dp" android:maxWidth="20dp" android:minHeight="14dp" android:maxHeight="14dp" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateTint="#FFFFFFFF" android:indeterminateTintMode="multiply"
        android:indeterminateDrawable="@drawable/w_bars_t80" android:visibility="gone" />
    <ProgressBar android:id="@+id/w_bars_90" android:layout_width="20dp" android:layout_height="14dp"
        android:minWidth="20dp" android:maxWidth="20dp" android:minHeight="14dp" android:maxHeight="14dp" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateTint="#FFFFFFFF" android:indeterminateTintMode="multiply"
        android:indeterminateDrawable="@drawable/w_bars_t90" android:visibility="gone" />
    <ProgressBar android:id="@+id/w_bars_100" android:layout_width="20dp" android:layout_height="14dp"
        android:minWidth="20dp" android:maxWidth="20dp" android:minHeight="14dp" android:maxHeight="14dp" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateTint="#FFFFFFFF" android:indeterminateTintMode="multiply"
        android:indeterminateDrawable="@drawable/w_bars_t100" android:visibility="gone" />
    <ProgressBar android:id="@+id/w_bars_115" android:layout_width="20dp" android:layout_height="14dp"
        android:minWidth="20dp" android:maxWidth="20dp" android:minHeight="14dp" android:maxHeight="14dp" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateTint="#FFFFFFFF" android:indeterminateTintMode="multiply"
        android:indeterminateDrawable="@drawable/w_bars_t115" android:visibility="gone" />
    <ProgressBar android:id="@+id/w_bars_135" android:layout_width="20dp" android:layout_height="14dp"
        android:minWidth="20dp" android:maxWidth="20dp" android:minHeight="14dp" android:maxHeight="14dp" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateTint="#FFFFFFFF" android:indeterminateTintMode="multiply"
        android:indeterminateDrawable="@drawable/w_bars_t135" android:visibility="gone" />
    <ImageView android:id="@+id/w_bars_off" android:layout_width="20dp" android:layout_height="14dp"
        android:src="@drawable/w_bars_off" android:contentDescription="@null" />
</FrameLayout>
