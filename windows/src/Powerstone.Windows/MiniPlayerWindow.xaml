<Window x:Class="Powerstone.Windows.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Powerstone.Windows.Controls"
        Title="88.8FM" Icon="Assets/app.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" ShowInTaskbar="True"
        Foreground="{StaticResource Text}" FontFamily="{StaticResource Mono}">
    <Window.InputBindings>
        <KeyBinding Key="Space" Command="{Binding Player.PlayPauseCommand}" />
        <KeyBinding Key="Right" Modifiers="Ctrl" Command="{Binding Player.NextCommand}" />
        <KeyBinding Key="Left" Modifiers="Ctrl" Command="{Binding Player.PreviousCommand}" />
        <KeyBinding Key="M" Modifiers="Ctrl" Command="{Binding ToggleMiniCommand}" />
    </Window.InputBindings>
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="8"
            Margin="8" MouseLeftButtonDown="Drag">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.6" />
        </Border.Effect>
        <Grid DataContext="{Binding Player}" Width="400">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="112" Height="112" CornerRadius="7,0,0,7" ClipToBounds="True" Background="{StaticResource Ink}">
                <Grid>
                <Rectangle Width="28" Height="28" Fill="{StaticResource Rose}" />
                <Image Source="{Binding Cover, Converter={StaticResource Img}}" Stretch="UniformToFill" ToolTip="Open the full player" Cursor="Hand" />
                </Grid>
            </Border>
            <DockPanel Grid.Column="1" Margin="10,6,6,6">
                <!-- title + window buttons -->
                <DockPanel DockPanel.Dock="Top">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <ToggleButton x:Name="Pin" ToolTip="Keep on top" Width="24" Height="22" Cursor="Hand" Click="Pin_Click"
                                      FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="11" Content="&#xE718;">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Foreground" Value="{StaticResource Dim}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{StaticResource Rose}" /></Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <Button Style="{StaticResource Icon}" FontSize="11" Padding="6,3" Content="&#xE740;" ToolTip="Full player (Ctrl+M)" Click="Expand_Click" />
                        <Button Style="{StaticResource Icon}" FontSize="11" Padding="6,3" Content="&#xE8BB;" ToolTip="Quit 88.8FM" Click="Quit_Click" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding Title, FallbackValue=88.8FM}" FontWeight="Bold" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource DimText}" />
                    </StackPanel>
                </DockPanel>
                <!-- transport -->
                <DockPanel DockPanel.Dock="Bottom">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SleepLabel}" Foreground="{StaticResource Rose}" FontSize="9" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Icon}" FontSize="13" Content="&#xE8B1;" ToolTip="Shuffle everything" Command="{Binding SmartShuffleCommand}"
                                Foreground="{Binding IsShuffle, Converter={StaticResource RoseOrDim}}" />
                        <Button Style="{StaticResource Icon}" FontSize="13" Content="&#xE892;" ToolTip="Previous" Command="{Binding PreviousCommand}" />
                        <Button Command="{Binding PlayPauseCommand}" Width="32" Height="32" Margin="4,0" Padding="0"
                                Background="{StaticResource Rose}" BorderBrush="{StaticResource Rose}" Foreground="White"
                                FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="13" Content="{Binding PlayGlyph}" ToolTip="Play / pause (Space)" />
                        <Button Style="{StaticResource Icon}" FontSize="13" Content="&#xE893;" ToolTip="Next" Command="{Binding NextCommand}" />
                        <Button Style="{StaticResource Icon}" FontSize="13" ToolTip="Favourite" Command="{Binding ToggleFavCommand}">
                            <Grid>
                                <TextBlock Text="&#xEB52;" Foreground="{StaticResource Rose}" Visibility="{Binding IsFav, Converter={StaticResource Vis}}" />
                                <TextBlock Text="&#xEB51;" Visibility="{Binding IsFav, Converter={StaticResource NotVis}}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </DockPanel>
                <!-- visualizer + seek -->
                <Grid>
                    <c:Visualizer Height="22" VerticalAlignment="Top" Opacity="0.55" Source="{Binding Engine.Spectrum}" IsActive="{Binding IsPlaying}" />
                    <Slider x:Name="Seek" VerticalAlignment="Bottom" Minimum="0" Maximum="{Binding SeekMax}" Value="{Binding Position, Mode=TwoWay}"
                            Thumb.DragStarted="Seek_DragStarted" Thumb.DragCompleted="Seek_DragCompleted"
                            PreviewMouseLeftButtonDown="Seek_PreviewMouseDown" PreviewMouseLeftButtonUp="Seek_PreviewMouseUp"
                            ToolTip="{Binding PositionText}" />
                </Grid>
            </DockPanel>
        </Grid>
    </Border>
</Window>
