<Window x:Class="Powerstone.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Powerstone.Windows.Controls"
        Title="88.8FM" Width="1220" Height="800" MinWidth="760" MinHeight="520"
        Icon="Assets/app.ico" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Ink}" Foreground="{StaticResource Text}" FontFamily="{StaticResource Mono}">
    <Window.InputBindings>
        <KeyBinding Key="Space" Modifiers="Ctrl" Command="{Binding Player.PlayPauseCommand}" />
        <KeyBinding Key="Right" Modifiers="Ctrl" Command="{Binding Player.NextCommand}" />
        <KeyBinding Key="Left" Modifiers="Ctrl" Command="{Binding Player.PreviousCommand}" />
        <KeyBinding Key="Back" Modifiers="Alt" Command="{Binding BackCommand}" />
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding BackCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Navigation rail -->
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,18,16,12">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="14" Height="14" Fill="{StaticResource Rose}" Margin="0,0,10,0" />
                        <TextBlock Text="88.8FM" FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock Text="{Binding TierText}" Style="{StaticResource DimText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Top">
                    <Button Style="{StaticResource Nav}" Command="{Binding GoCatalogueCommand}" Content="Catalogue" />
                    <Button Style="{StaticResource Nav}" Command="{Binding GoBpmCommand}" Content="Browse by BPM" />
                    <Button Style="{StaticResource Nav}" Command="{Binding Player.SmartShuffleCommand}" Content="Shuffle everything" />
                    <Button Style="{StaticResource Nav}" Command="{Binding GoMeCommand}" Content="MY 88.8" />
                    <Button Style="{StaticResource Nav}" Command="{Binding GoAccountCommand}" Content="Account" />
                    <Button Style="{StaticResource Nav}" Command="{Binding GoSoundCommand}" Content="Sound · EQ" />
                    <Button Style="{StaticResource Nav}" Command="{Binding GoPlaylistsCommand}" Margin="0,14,0,0">
                        <TextBlock Text="PLAYLISTS" Foreground="{StaticResource Rose}" FontSize="11" FontWeight="Bold" />
                    </Button>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PlaylistList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Nav}" Padding="16,6"
                                        Command="{Binding DataContext.OpenPlaylistItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Dim}" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Page -->
        <DockPanel Grid.Column="1">
            <Grid DockPanel.Dock="Top" Margin="12,8,12,0" Visibility="{Binding CanGoBack, Converter={StaticResource Vis}}">
                <Button Style="{StaticResource Icon}" Content="&#xE72B;" ToolTip="Back (Alt+Left)" Command="{Binding BackCommand}" HorizontalAlignment="Left" />
            </Grid>
            <ContentControl Content="{Binding Page}" Focusable="False" />
        </DockPanel>

        <!-- Toast -->
        <Border Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16"
                Background="{StaticResource Rose}" CornerRadius="3" Padding="14,8"
                Visibility="{Binding Toast, Converter={StaticResource NullVis}}">
            <TextBlock Text="{Binding Toast}" Foreground="White" />
        </Border>

        <!-- Player bar -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0"
                DataContext="{Binding Player}">
            <Grid Margin="12,8" Height="76">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Padding="0" BorderThickness="0" Command="{Binding OpenCurrentReleaseCommand}" ToolTip="Go to release">
                    <Image Source="{Binding Cover, Converter={StaticResource Img}}" Width="64" Height="64" Stretch="UniformToFill" />
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource DimText}" />
                    <TextBlock Text="{Binding Meta}" Style="{StaticResource DimText}" />
                    <TextBlock Text="PREVIEW" Foreground="{StaticResource Rose}" FontSize="10" FontWeight="Bold"
                               Visibility="{Binding IsPreview, Converter={StaticResource Vis}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" MaxWidth="640">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource Icon}" Content="&#xE8B1;" ToolTip="Shuffle the whole catalogue" Command="{Binding SmartShuffleCommand}"
                                Foreground="{Binding IsShuffle, Converter={StaticResource RoseOrDim}}" />
                        <Button Style="{StaticResource Icon}" Content="&#xE892;" ToolTip="Previous (Ctrl+Left)" Command="{Binding PreviousCommand}" />
                        <Button Command="{Binding PlayPauseCommand}" ToolTip="Play / pause (Ctrl+Space)" Width="44" Height="44" Margin="10,0"
                                Background="{StaticResource Rose}" BorderBrush="{StaticResource Rose}" Foreground="White" Padding="0"
                                FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="18" Content="{Binding PlayGlyph}" />
                        <Button Style="{StaticResource Icon}" Content="&#xE893;" ToolTip="Next (Ctrl+Right)" Command="{Binding NextCommand}" />
                        <Button Style="{StaticResource Icon}" Content="&#xE8ED;" ToolTip="Repeat 1" Command="{Binding ToggleRepeatOneCommand}"
                                Foreground="{Binding RepeatOne, Converter={StaticResource RoseOrDim}}" />
                        <Button Style="{StaticResource Icon}" Content="&#xE8EE;" ToolTip="Repeat tape (whole queue)" Command="{Binding ToggleRepeatTapeCommand}"
                                Foreground="{Binding RepeatTape, Converter={StaticResource RoseOrDim}}" />
                    </StackPanel>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding PositionText}" Style="{StaticResource DimText}" VerticalAlignment="Center" />
                        <Slider x:Name="Seek" Grid.Column="1" Minimum="0" Maximum="{Binding Duration}" Value="{Binding Position, Mode=TwoWay}"
                                Thumb.DragStarted="Seek_DragStarted" Thumb.DragCompleted="Seek_DragCompleted"
                                PreviewMouseLeftButtonDown="Seek_PreviewMouseDown" PreviewMouseLeftButtonUp="Seek_PreviewMouseUp" />
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource DimText}" VerticalAlignment="Center" TextAlignment="Right" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Icon}" ToolTip="Favourite" Command="{Binding ToggleFavCommand}">
                        <Grid>
                            <TextBlock Text="&#xEB52;" Foreground="{StaticResource Rose}" Visibility="{Binding IsFav, Converter={StaticResource Vis}}" />
                            <TextBlock Text="&#xEB51;" Visibility="{Binding IsFav, Converter={StaticResource NotVis}}" />
                        </Grid>
                    </Button>
                    <c:Visualizer Width="120" Height="40" Margin="8,0" Source="{Binding Engine.Spectrum}" IsActive="{Binding IsPlaying}" />
                    <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" VerticalAlignment="Center" Foreground="{StaticResource Dim}" Margin="4,0" />
                    <Slider Width="90" Minimum="0" Maximum="1" Value="{Binding Volume}" VerticalAlignment="Center" ToolTip="Volume" />
                    <Button Style="{StaticResource Icon}" Content="&#xE9E9;" ToolTip="Sound · EQ"
                            Command="{Binding DataContext.GoSoundCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Button Style="{StaticResource Icon}" Content="&#xE8FD;" ToolTip="Now playing &amp; up next"
                            Command="{Binding DataContext.GoNowPlayingCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
